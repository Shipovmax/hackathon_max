# Скопируйте в .env и заполните. Файл .env в git не добавлять.

# Бот MAX: токен (секрет) и ник без @
BOT_TOKEN=
BOT_USERNAME=t185_hakaton_max_bot
MAX_API_BASE=https://platform-api2.max.ru
MAX_CA_BUNDLE=certs/Russian_Trusted_Root_CA.cer

# Django: на сервере DJANGO_DEBUG=0 и свой секретный ключ
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
FRAME_ANCESTORS=https://max.ru https://*.max.ru

# Публичный адрес и домен сервера (для https через Caddy)
PUBLIC_BASE_URL=
DOMAIN=

# База данных: пустой POSTGRES_HOST — SQLite для локальной разработки
POSTGRES_DB=shiftcontrol
POSTGRES_USER=shiftcontrol
POSTGRES_PASSWORD=shiftcontrol
POSTGRES_HOST=
POSTGRES_PORT=5432

# Срок действия подписи запуска мини-приложения, секунды
INIT_DATA_MAX_AGE_SECONDS=86400

# Вход для автоматической проверки API (секрет); пустой токен выключает вход
REVIEW_API_TOKEN=
REVIEW_OWNER_MAX_ID=900000001

# Напоминания, эскалации и допуски, минуты
REMINDER_FIRST_MINUTES_BEFORE=15
REMINDER_FINAL_MINUTES_BEFORE=5
CLAIM_ESCALATION_MINUTES_BEFORE=15
PHOTO_WAIT_MINUTES=10
SHIFT_BOUNDARY_TOLERANCE_MINUTES=5

SCHEDULER_INTERVAL_SECONDS=30
LOG_LEVEL=INFO
