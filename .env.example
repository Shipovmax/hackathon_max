# Copy to .env and fill in. Never commit .env.

# Bot token issued by the organizers (secret).
BOT_TOKEN=
# Bot nickname without @, used for the mini-app deep link.
BOT_USERNAME=t185_hakaton_max_bot
MAX_API_BASE=https://platform-api2.max.ru
# Russian Trusted Root CA that signs platform-api2.max.ru (inside Docker it is set to /app/certs/...).
MAX_CA_BUNDLE=certs/Russian_Trusted_Root_CA.cer

# Django. With DJANGO_DEBUG=1 an insecure dev key is used; for a public deploy set DEBUG=0 and a real secret key.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
# Comma separated. Add the public host (or tunnel host) that serves the mini-app.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Origins allowed to embed the mini-app in a frame (MAX web client).
FRAME_ANCESTORS=https://max.ru https://*.max.ru
# Public https URL of the deployed mini-app.
PUBLIC_BASE_URL=

# Database. Leave POSTGRES_HOST empty to use SQLite locally; docker compose sets it to "db".
POSTGRES_DB=shiftcontrol
POSTGRES_USER=shiftcontrol
POSTGRES_PASSWORD=shiftcontrol
POSTGRES_HOST=
POSTGRES_PORT=5432

# Recommended by MAX is 3600; a longer window keeps a long-open mini-app working.
INIT_DATA_MAX_AGE_SECONDS=86400
REMINDER_MINUTES_BEFORE=5
CLAIM_ESCALATION_MINUTES_BEFORE=15
PHOTO_WAIT_MINUTES=10
SHIFT_BOUNDARY_TOLERANCE_MINUTES=5
SCHEDULER_INTERVAL_SECONDS=30
LOG_LEVEL=INFO
